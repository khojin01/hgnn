filters:
  and:
    - file.inFolder("hgnn/datasets")
properties:
  file.name:
    displayName: 데이터셋
  nc_models:
    displayName: NC 모델 수
  nc_best:
    displayName: NC 1위
  nc_best_value:
    displayName: NC 1위 값
  hp_models:
    displayName: HP 모델 수
  hp_best:
    displayName: HP 1위
  hp_best_value:
    displayName: HP 1위 값
views:
  - type: table
    name: 전체
    order:
      - file.name
      - nc_models
      - nc_best
      - nc_best_value
      - hp_models
      - hp_best
      - hp_best_value
    sort:
      - property: nc_models
        direction: DESC
